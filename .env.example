# ============================================================
# Gnani AI Business Agent — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gnani_agent
POSTGRES_USER=gnani
POSTGRES_PASSWORD=gnani_secret
DATABASE_URL=postgresql://gnani:gnani_secret@localhost:5432/gnani_agent

# ─────────────────────────────────────────
# n8n
# ─────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=gnani_n8n_secret

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# Gnani APIs — get from Gnani AI portal
# ─────────────────────────────────────────
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_URL=https://api.gnani.ai/v1/prisma   # speech-to-text
# ─────────────────────────────────────────
# Gemini API (replaces Gnani Evon for reasoning)
# ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────
# Demo Integrations (use DEMO accounts only)
# ─────────────────────────────────────────

# Gmail OAuth2 (create a dedicated demo Gmail account)
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_DEMO_ADDRESS=demo@yourdomain.com

# Slack (create a demo Slack workspace + Bot token)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_DEMO_CHANNEL=#logistics-demo

# WhatsApp Business API (use Meta test credentials)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Google Calendar (same OAuth as Gmail or service account)
GOOGLE_CALENDAR_ID=demo@yourdomain.com

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key_32chars
JWT_SECRET=change_this_to_another_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─────────────────────────────────────────
# Demo Organization IDs
# ─────────────────────────────────────────
DEMO_ORG_ID=00000000-0000-0000-0000-000000000001
DEMO_ADMIN_USER_ID=00000000-0000-0000-0000-000000000010

