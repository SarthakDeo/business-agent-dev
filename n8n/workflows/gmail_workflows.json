      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\nconst params = payload.parameters || {};\n\nconst sampleEmails = [\n  {\n    id: 'msg_001',\n    from: 'john@example.com',\n    subject: 'Delayed shipment update requested',\n    snippet: 'When will my delayed package arrive?',\n    date: '2026-11-04T12:00:00Z'\n  }\n];\n\nreturn [{\n  json: {\n    success: true,\n    provider_reference: 'gmail_search_' + Date.now(),\n    emails: sampleEmails,\n    count: sampleEmails.length,\n    normalized_data: { emails: sampleEmails, count: sampleEmails.length }\n  }\n}];"
      },
      "id": "node-gmail-search-handler",
